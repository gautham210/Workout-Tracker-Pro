{
  "expo": {
    "name": "Workout Tracker Pro",
    "slug": "workout-tracker-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "workouttrackerpro",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gautham210.workouttrackerpro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gautham210.workouttrackerpro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      ["expo-image-picker", { "photosPermission": "Allow Workout Tracker Pro to select meal photos for analysis." }]
    ]
  }
}
